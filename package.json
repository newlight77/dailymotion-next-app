  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^1.6.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "next": "^16.3.1",
    "next-auth": "^4.24.15",
    "node-fetch": "^3.3.2",
    "prisma": "^6.19.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "ts-node": "^10.9.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "uuid": "^14.0.2",
    "effect": "3.20.0",
    "defu": "6.1.5",
    "diff": "4.0.4",
    "flatted": "3.4.2",
    "picomatch": "4.0.4"
